{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:goal",
  "title": "Goal",
  "description": "User goal tracking per §36",
  "type": "object",
  "required": ["goal_id", "user_id", "goal_type", "status"],
  "properties": {
    "goal_id": {
      "type": "string",
      "description": "Globally unique goal identifier (UUID)"
    },
    "user_id": {
      "type": "string"
    },
    "goal_type": {
      "type": "string",
      "enum": ["productivity", "health", "habit", "focus", "custom"],
      "description": "Goal category"
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed", "paused", "abandoned"],
      "description": "Goal status"
    },
    "payload": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "target": {
          "type": "object",
          "properties": {
            "metric": { "type": "string" },
            "value": { "type": "number" },
            "unit": { "type": "string" },
            "deadline": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
