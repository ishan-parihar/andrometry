{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:habit",
  "title": "Habit",
  "description": "Habit tracking per §38",
  "type": "object",
  "required": ["habit_id", "user_id", "habit_type", "target", "schedule", "status"],
  "properties": {
    "habit_id": {
      "type": "string",
      "description": "Globally unique habit identifier (UUID)"
    },
    "user_id": {
      "type": "string"
    },
    "habit_type": {
      "type": "string",
      "enum": ["exercise", "meditation", "reading", "sleep_schedule", "hydration", "custom"],
      "description": "Habit category"
    },
    "target": {
      "type": "object",
      "description": "Habit target definition",
      "properties": {
        "metric": { "type": "string" },
        "minimum": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "schedule": {
      "type": "object",
      "description": "When the habit should be performed",
      "properties": {
        "days": {
          "type": "array",
          "items": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
        },
        "window": { "type": "string", "description": "Time window (e.g. 07:00-09:00)" }
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Data sources for automatic completion detection"
    },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "completed", "abandoned"],
      "default": "active"
    },
    "streak_days": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Current consecutive days streak"
    },
    "habit_strength": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Habit strength score (0-1)"
    },
    "exception_rules": {
      "type": ["string", "null"],
      "description": "JSON-encoded exception rules"
    }
  }
}
