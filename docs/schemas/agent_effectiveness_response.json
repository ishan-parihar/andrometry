{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:agent_effectiveness_response",
  "title": "Agent Effectiveness Response",
  "description": "Agent effectiveness endpoint response",
  "type": "object",
  "required": ["agent_id", "effectiveness"],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "effectiveness": {
      "type": "object",
      "properties": {
        "total_interventions": { "type": "integer" },
        "accepted_count": { "type": "integer" },
        "dismissed_count": { "type": "integer" },
        "acceptance_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "avg_effectiveness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "behavior_change_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "period_days": { "type": "integer" }
      }
    }
  }
}
