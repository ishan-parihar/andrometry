{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:permission_state",
  "title": "Permission State",
  "description": "Device permission state per §7.2",
  "type": "object",
  "required": ["updated_at", "state"],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "object",
      "properties": {
        "usage_stats": { "type": "boolean" },
        "notification_listener": { "type": "boolean" },
        "notification_listener_restricted": { "type": "boolean" },
        "calendar": { "type": "boolean" },
        "location": { "type": "boolean" },
        "background_location": { "type": "boolean" },
        "health_connect": { "type": "boolean" },
        "health_connect_steps": { "type": "boolean" },
        "health_connect_sleep": { "type": "boolean" },
        "health_connect_heart_rate": { "type": "boolean" },
        "battery_optimization_exempt": { "type": "boolean" }
      }
    }
  }
}
