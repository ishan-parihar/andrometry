{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:app_classification",
  "title": "App Classification",
  "description": "Per-app classification metadata per §9.1",
  "type": "object",
  "required": ["package", "category", "source"],
  "properties": {
    "package": {
      "type": "string",
      "description": "Android package name (e.g. com.notion.id)"
    },
    "category": {
      "type": "string",
      "enum": [
        "productivity", "communication", "calendar", "email", "browser",
        "social", "entertainment", "news", "finance", "health",
        "travel", "shopping", "maps", "system", "unknown"
      ],
      "description": "App category"
    },
    "subcategory": {
      "type": "string",
      "description": "Optional subcategory (e.g. notes, video)"
    },
    "alignment": {
      "type": "string",
      "enum": ["aligned", "neutral", "misaligned"],
      "description": "User-defined alignment value"
    },
    "source": {
      "type": "string",
      "enum": ["android_category", "user_override", "heuristic", "remote_pack"],
      "description": "Classification source"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
