{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:daily_summary",
  "title": "Daily Summary",
  "description": "Daily summary object per §17.6",
  "type": "object",
  "required": ["date", "timezone", "summary"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date in YYYY-MM-DD format"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "summary": {
      "type": "object",
      "description": "Structured daily summary",
      "properties": {
        "deep_work_minutes": { "type": "integer" },
        "meeting_minutes": { "type": "integer" },
        "distraction_minutes": { "type": "integer" },
        "sleep_minutes": { "type": "integer" },
        "steps": { "type": "integer" },
        "alignment_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "work_patterns": {
          "type": "object",
          "properties": {
            "average_focus_bout_minutes": { "type": "number" },
            "switching_rate_per_hour": { "type": "number" },
            "meeting_fragmentation_score": { "type": "number" }
          }
        }
      }
    }
  }
}
