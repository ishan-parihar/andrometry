{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:hourly_summary",
  "title": "Hourly Summary",
  "description": "Hourly summary object per §13.1",
  "type": "object",
  "required": ["start_time", "end_time", "summary"],
  "properties": {
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "description": "Hourly summary payload"
    }
  }
}
