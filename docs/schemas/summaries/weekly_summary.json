{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:weekly_summary",
  "title": "Weekly Summary",
  "description": "Weekly summary object per §17.7",
  "type": "object",
  "required": ["week", "timezone", "summary"],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$",
      "description": "ISO week in YYYY-Www format"
    },
    "timezone": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "summary": {
      "type": "object",
      "description": "Structured weekly summary"
    }
  }
}
