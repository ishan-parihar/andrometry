{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:agent-intervention:v1",
  "title": "Agent Intervention",
  "description": "An intervention proposed by an AI agent",
  "type": "object",
  "required": ["intervention_id", "agent_id", "intervention_type", "title", "message", "severity", "timestamp"],
  "properties": {
    "intervention_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intervention_type": {
      "type": "string",
      "enum": ["nudge", "suggestion", "warning", "reflection_prompt", "goal_reminder", "habit_check", "break_suggestion", "focus_extend", "energy_check"]
    },
    "title": {
      "type": "string",
      "maxLength": 256
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "suggested_action": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved_by_policy", "delivered", "accepted", "dismissed", "ignored", "completed", "failed", "suppressed", "expired"],
      "default": "proposed"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "evidence": {
      "type": "object"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
