{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://andrometry.dev/schemas/data_quality_response.json",
  "title": "Data Quality Response",
  "description": "Response from GET /v1/context/data-quality (§11.4)",
  "type": "object",
  "required": ["completeness", "staleness_seconds", "missing_collectors", "degraded_collectors", "permission_issues", "clock_drift_detected"],
  "properties": {
    "completeness": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of expected data signals present (0.0-1.0)" },
    "staleness_seconds": { "type": "integer", "description": "Seconds since last context update (-1 if unknown)" },
    "last_context_time": { "type": "string", "description": "ISO 8601 timestamp of last context" },
    "etag": { "type": "string", "description": "Context ETag for conditional requests" },
    "missing_collectors": { "type": "array", "items": { "type": "string" }, "description": "Collectors with no data" },
    "degraded_collectors": { "type": "array", "items": { "type": "string" }, "description": "Collectors with stale data" },
    "permission_issues": { "type": "array", "items": { "type": "string" }, "description": "Collectors with permission problems" },
    "clock_drift_detected": { "type": "boolean", "description": "Whether context timestamp is significantly in the future" },
    "message": { "type": "string", "description": "Optional status message" }
  },
  "additionalProperties": false
}
