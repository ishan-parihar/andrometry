{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "andrometry:daily-summary:v1",
  "title": "Daily Summary",
  "description": "Rich daily summary for reflection and coaching",
  "type": "object",
  "required": ["date", "timezone"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string"
    },
    "sleep": {
      "type": "object",
      "properties": {
        "minutes": { "type": "integer" },
        "regularity_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "bedtime": { "type": "string", "format": "date-time" },
        "wake_time": { "type": "string", "format": "date-time" }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "steps": { "type": "integer" },
        "exercise_minutes": { "type": "integer" },
        "active_minutes": { "type": "integer" }
      }
    },
    "work": {
      "type": "object",
      "properties": {
        "deep_work_minutes": { "type": "integer" },
        "shallow_work_minutes": { "type": "integer" },
        "meeting_minutes": { "type": "integer" },
        "admin_minutes": { "type": "integer" }
      }
    },
    "distraction": {
      "type": "object",
      "properties": {
        "total_minutes": { "type": "integer" },
        "social_minutes": { "type": "integer" },
        "browser_hopping_minutes": { "type": "integer" },
        "during_focus_minutes": { "type": "integer" }
      }
    },
    "interruptions": {
      "type": "object",
      "properties": {
        "notification_count": { "type": "integer" },
        "unlock_count": { "type": "integer" },
        "app_switch_count": { "type": "integer" }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "home_minutes": { "type": "integer" },
        "office_minutes": { "type": "integer" },
        "gym_minutes": { "type": "integer" },
        "commute_minutes": { "type": "integer" }
      }
    },
    "focus": {
      "type": "object",
      "properties": {
        "sessions": { "type": "integer" },
        "successful_sessions": { "type": "integer" },
        "average_interruptions": { "type": "number" }
      }
    },
    "work_patterns": {
      "type": "object",
      "properties": {
        "average_focus_bout_minutes": { "type": "number" },
        "switching_rate_per_hour": { "type": "number" },
        "meeting_fragmentation_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "late_night_work_minutes": { "type": "integer" }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "alignment": { "type": "number", "minimum": 0, "maximum": 1 },
        "productivity": { "type": "number", "minimum": 0, "maximum": 1 },
        "wellbeing": { "type": "number", "minimum": 0, "maximum": 1 },
        "focus_control": { "type": "number", "minimum": 0, "maximum": 1 },
        "sleep_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "readiness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "baselines": {
      "type": "object",
      "properties": {
        "deep_work_minutes_7d_avg": { "type": "number" },
        "distraction_minutes_7d_avg": { "type": "number" },
        "sleep_minutes_7d_avg": { "type": "number" }
      }
    }
  },
  "additionalProperties": false
}
